{
    "name": "@benjamolina/opencode-antigravity-guard",
    "version": "1.1.22",
    "description": "Google Antigravity OAuth plugin for OpenCode with strict reset-time quota locking",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "license": "MIT",
    "author": "benjamolina",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/BenjaMolina/opencode-antigravity-guard.git"
    },
    "homepage": "https://github.com/BenjaMolina/opencode-antigravity-guard#readme",
    "bugs": {
        "url": "https://github.com/BenjaMolina/opencode-antigravity-guard/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "workspaces": [
        "packages/core",
        "packages/pi"
    ],
    "keywords": [
        "opencode",
        "google",
        "antigravity",
        "gemini",
        "oauth",
        "plugin",
        "auth",
        "claude"
    ],
    "engines": {
        "node": ">=20.0.0"
    },
    "files": [
        "dist/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "npm run build:core && npm run build:opencode",
        "build:opencode": "tsc -p tsconfig.build.json && npx tsx scripts/fix-esm-imports.ts",
        "build:core": "npm run build --workspace=@benjamolina/antigravity-guard-core",
        "build:pi": "npm run build --workspace=@benjamolina/pi-antigravity-guard",
        "build:all": "npm run build && npm run build:pi",
        "build:schema": "npx tsx script/build-schema.ts",
        "typecheck": "npm run build:core && npm run typecheck:opencode",
        "typecheck:opencode": "tsc --noEmit",
        "typecheck:core": "npm run typecheck --workspace=@benjamolina/antigravity-guard-core",
        "typecheck:pi": "npm run typecheck --workspace=@benjamolina/pi-antigravity-guard",
        "typecheck:all": "npm run typecheck && npm run typecheck:pi",
        "test": "npm run build:core && vitest run",
        "test:pack": "npx tsx scripts/pack-consumer.ts",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "prepack": "npm run build:opencode",
        "prepublishOnly": "npm run build",
        "test:e2e:models": "npx tsx script/test-models.ts",
        "test:e2e:regression": "npx tsx script/test-regression.ts",
        "test:pi-tool-loop-probe": "vitest run scripts/pi-tool-loop-probe.test.ts",
        "probe:pi-tool-loop": "tsx scripts/pi-tool-loop-probe.ts --live"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "@types/proper-lockfile": "^4.1.4",
        "@vitest/coverage-v8": "^3.0.0",
        "@vitest/ui": "^3.0.0",
        "@earendil-works/pi-ai": "0.85.1",
        "@earendil-works/pi-coding-agent": "0.85.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^3.0.0",
        "zod-to-json-schema": "^3.25.1"
    },
    "dependencies": {
        "@benjamolina/antigravity-guard-core": "0.1.0",
        "@openauthjs/openauth": "^0.4.3",
        "@opencode-ai/plugin": "^1.2.10",
        "proper-lockfile": "^4.1.2",
        "xdg-basedir": "^5.1.0",
        "zod": "^4.0.0"
    }
}
